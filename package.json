{
  "name": "wingtoolui",
  "version": "1.3.0",
  "description": "A browser-based paraglider design tool implementing the Laboratori d'Envol handbook, validated against production data from five manufacturers.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "check": "node tools/check.mjs",
    "test": "node tests/run-tests.js",
    "test:phase1": "node tests/phase1-audit.mjs",
    "test:pipeline": "node tests/full-pipeline.mjs",
    "test:ui": "node tools/ui-test.cjs",
    "test:controls": "node tools/dead-controls.cjs",
    "test:refs": "node tests/reference-sweep.mjs",
    "check:assertions": "node tools/check-assertions.mjs",
    "check:units": "node tools/check-units.mjs",
    "check:references": "node tools/check-references.mjs",
    "check:options": "node tools/check-options.mjs",
    "check:corpus": "node tools/corpus-learnings.mjs",
    "check:provenance": "node tools/check-provenance.mjs",
    "bench": "node tests/benchmark.js",
    "audit": "node tools/audit.mjs",
    "build": "python3 build.py",
    "catalogue": "node tools/catalogue.mjs",
    "manifest": "node tools/manifest.mjs",
    "diagrams": "node tools/make-diagrams.mjs",
    "find": "node tools/find.mjs"
  },
  "keywords": [
    "paraglider",
    "wing-design",
    "aerodynamics",
    "cad",
    "dxf",
    "cutting-patterns"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/freeflightlab/wingtoolui"
  },
  "license": "GPL-3.0-only"
}
